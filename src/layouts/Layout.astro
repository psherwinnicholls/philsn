---
import "../styles/global.css"

interface Props {
  title?: string
  description?: string
  noindex?: boolean
}

const {
  title = "Phil Sherwin-Nicholls",
  description = "Design leader taking ideas from zero to one. At frog, I lead teams that design services, deliver agentic tools and reinvent organisations.",
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const shareImage = new URL("/og.png", Astro.site)
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="preload"
      href="/fonts/ClashDisplay-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Phil Sherwin-Nicholls" />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Phil Sherwin-Nicholls, design leader, in bold black type on orange" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
