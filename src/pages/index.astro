---
import Layout from "../layouts/Layout.astro"

const jobs = [
  {
    client: "Public sector",
    role: "Improving the data foundations of five organisations to unlock a potential £2bn market",
    description: "Leading a team of seven to unpick the legal and cultural barriers to data sharing, and prototyping tools for compliance and a single customer view.",
  },
  {
    client: "DEFRA",
    role: "Setting up a Policy Design Lab for DEFRA's £2.25b farming programme",
    description: "Designing the vision, operating model and business case for a lab that has green-lit 12 policies and disproven two, saving an estimated £40m.",
  },
  {
    client: "frog",
    role: "Creating a bootcamp to grow user-centred design capability",
    description: "Writing the business case, operating model and 25 hours of content for a bootcamp that’s now part of a global training offer.",
  },
  {
    client: "Ministry of Justice",
    role: "Helping eight organisations move off a legacy system",
    description: "Shaping the strategy, operating model and ways of working for eight organisations, with a roadmap to end their reliance on a legacy system.",
  },
  {
    client: "DCMS",
    role: "Helping government make better use of data",
    description: "Taking a holistic view of DCMS's data landscape to enable better knowledge sharing with the department's users.",
  },
  {
    client: "DCMS",
    role: "Building the foundations of a digital transformation programme for DCMS",
    description: "Mapping DCMS's services and service lines to develop a user-centred roadmap for change across the department.",
  },
  {
    client: "DfE",
    role: "Co-designing a service to help people retrain into new careers",
    description: "Leading service design on the £100m National Retraining Scheme, bringing careers guidance, online learning and job search into one service.",
  },
  {
    client: "Parity Projects",
    role: "Helping reduce fuel poverty in England",
    description: "Redesigning a service that helps property owners make their buildings more energy efficient, with Parity Projects.",
  },
  {
    client: "Florence",
    role: "Creating a strategy and design system for rapid development of health care services",
    description: "Working with Florence to enable faster prototyping and more accessible digital services for health care professionals.",
  },
  {
    client: "Cabinet Office",
    role: "Designing an AI-powered search engine for government",
    description: "Helping the Cabinet Office make sense of the knowledge trapped in billions of documents spread across government.",
  },
]

const links = [
  {
    text: "Designing a retraining scheme that meets user needs",
    source: "DfE Digital blog",
    url: "https://dfedigital.blog.gov.uk/2018/12/20/designing-a-retraining-scheme-that-meets-user-needs/",
  },
  {
    text: "Are you an easy hacking target? Cybersecurity tips for small business",
    source: "The Guardian",
    url: "https://www.theguardian.com/small-business-network/2017/sep/08/are-you-an-easy-hacking-target-cyber-security-tips-for-small-business",
  },
  {
    text: "Education Secretary sets out vision for character and resilience",
    source: "GOV.UK",
    url: "https://www.gov.uk/government/news/education-secretary-sets-out-vision-for-character-and-resilience",
  },
  {
    text: "Product Hunt launch of Hacksy",
    source: "Product Hunt",
    url: "https://www.producthunt.com/posts/hacksy-by-decoded",
  },
]

const pad = (n: number) => String(n).padStart(2, "0")

// Masthead name split into letters; --i staggers the intro animation
let letterIndex = 0
const nameLines = ["Phil", "Sherwin-", "Nicholls"].map((line) =>
  [...line].map((char) => ({ char, i: letterIndex++ })),
)
---

<Layout>
  <main>
    <header class="masthead">
      <p class="label">Design / Technology / Data / Mentoring</p>
      <h1 class="name">
        <span class="visually-hidden">Phil Sherwin-Nicholls</span>
        <span aria-hidden="true">
          {nameLines.map((letters) => (
            <span class="line">
              {letters.map(({ char, i }) => (
                <span class="letter" style={`--i: ${i}`} data-char={char}>
                  <span class="glyph">{char}</span>
                </span>
              ))}
            </span>
          ))}
        </span>
      </h1>
    </header>

    <section class="block" aria-labelledby="about">
      <h2 class="label" id="about">00 / About</h2>
      <div>
        <p class="lead">A service designer, digital technologist and mentor.</p>
        <p class="lead">
          Working at the intersection of technology, data and design &mdash; I help governments, businesses and charities solve wicked, population scale problems.
        </p>
        <p class="contact">
          Get in touch via <a target="_blank" rel="noopener noreferrer" href="https://www.linkedin.com/in/philsn/">LinkedIn&nbsp;↗</a>
        </p>
      </div>
    </section>

    <section class="block" aria-labelledby="work">
      <h2 class="label" id="work">01 / Selected work</h2>
      <ol class="rows">
        {jobs.map((job, i) => (
          <li class="row job">
            <span class="label num">{pad(i + 1)}</span>
            <h3 class="title">{job.role}</h3>
            <p class="desc">
              {job.client && <span class="label client">{job.client}</span>}
              {job.description}
            </p>
          </li>
        ))}
      </ol>
    </section>

    <section class="block" aria-labelledby="featured">
      <h2 class="label" id="featured">02 / Featured in</h2>
      <ol class="rows">
        {links.map((link, i) => (
          <li class="row">
            <a class="feature" href={link.url}>
              <span class="label num">{pad(i + 1)}</span>
              <span class="title">{link.text}</span>
              <span class="label source">{link.source}&nbsp;↗</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <footer class="block footer">
      <p class="label">Phil Sherwin-Nicholls</p>
      <p class="label"><a href="#top">Back to top&nbsp;↑</a></p>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 82rem;
    margin: 0 auto;
    padding: var(--gutter);
  }

  /* Masthead */

  .masthead {
    border-top: var(--rule);
    padding-top: 0.75rem;
    margin-bottom: clamp(3rem, 2rem + 5vw, 6rem);
    container-type: inline-size;
    overflow-x: clip;
    view-timeline: --masthead block;
  }

  .name {
    margin: clamp(1.5rem, 1rem + 3vw, 3.5rem) 0 0;
    font-family: var(--display);
    /* "Sherwin-" is ~5em wide in Clash Display, so this fills the column */
    font-size: 19cqi;
    font-weight: 600;
    line-height: 0.86;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .line {
    display: block;
  }

  /* Each letter reserves its bold width (::before, invisible) so weight
     changes don't reflow the line or shift letters under the pointer */
  .letter {
    display: inline-grid;
    justify-items: center;
  }

  .letter::before {
    content: attr(data-char);
    grid-area: 1 / 1;
    font-weight: 600;
    visibility: hidden;
  }

  .glyph {
    grid-area: 1 / 1;
  }

  /* Clash Display's weight axis runs 200–700; the name rests at 600 */

  @media (prefers-reduced-motion: no-preference) {
    /* Intro: each letter swells from hairline to bold, left to right */
    .glyph {
      animation: weight-in 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
      animation-delay: calc(var(--i) * 45ms + 150ms);
    }

    /* Hover: the letter under the pointer thins, its neighbours partly */
    @media (hover: hover) and (pointer: fine) {
      .glyph {
        transition: font-weight 0.35s ease-out;
      }

      .letter:has(+ .letter:hover) .glyph,
      .letter:hover + .letter .glyph {
        font-weight: 400;
      }

      .letter:hover .glyph {
        font-weight: 200;
      }
    }

    /* Scroll: lines drift apart and thin out as the masthead leaves */
    @supports (animation-timeline: view()) {
      .line {
        animation: drift linear both;
      }

      /* Separate rule: the minifier would otherwise fold the timeline into
         the animation shorthand, which browsers reject */
      .masthead .line {
        animation-timeline: --masthead;
        animation-range: exit 0% exit 70%;
      }

      .line:nth-child(odd) {
        --drift: 14%;
      }

      .line:nth-child(even) {
        --drift: -14%;
      }
    }
  }

  @keyframes weight-in {
    from {
      font-weight: 200;
    }
  }

  @keyframes drift {
    to {
      font-weight: 200;
      transform: translateX(var(--drift));
    }
  }

  /* Sections */

  .block {
    border-top: var(--rule);
    padding-top: 0.75rem;
    margin-bottom: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    display: grid;
    gap: 1.5rem;
  }

  @media (min-width: 56rem) {
    .block {
      grid-template-columns: 1fr 3fr;
      gap: var(--gutter);
    }
  }

  .lead {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 30ch;
    margin: 0 0 0.6em;
    text-wrap: pretty;
  }

  .contact {
    margin: 2rem 0 0;
    font-size: var(--step-0);
  }

  .contact a {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 600;
  }

  /* Numbered rows */

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .row {
    border-bottom: var(--hairline);
  }

  .row:first-child {
    border-top: var(--hairline);
  }

  @media (min-width: 56rem) {
    .row:first-child {
      border-top: none;
    }
  }

  .job,
  .feature {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 0.5rem;
    padding: 1.25rem 0;
  }

  .num {
    padding-top: 0.35em;
  }

  .title {
    margin: 0;
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
  }

  .desc {
    grid-column: 2;
    margin: 0.6rem 0 0;
    color: var(--muted);
    max-width: 68ch;
    text-wrap: pretty;
  }

  .client {
    display: block;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }

  /* Featured links: whole row is the link and inverts on hover */

  .feature {
    text-decoration: none;
    padding-left: 0;
    padding-right: 0;
    transition: padding 0.15s ease-out;
  }

  .feature .title {
    text-decoration-line: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.16em;
  }

  .source {
    grid-column: 2;
    margin-top: 0.6rem;
    color: var(--muted);
  }

  .feature:hover {
    padding-left: 0.75rem;
    padding-right: 0.75rem;
  }

  .feature:hover .source {
    color: inherit;
  }

  @media (min-width: 72rem) {
    .feature {
      grid-template-columns: 2.5rem 1fr auto;
      column-gap: 1.5rem;
      align-items: baseline;
    }

    .source {
      grid-column: 3;
      margin-top: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature {
      transition: none;
    }
  }

  /* Footer */

  .footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0;
  }
</style>
